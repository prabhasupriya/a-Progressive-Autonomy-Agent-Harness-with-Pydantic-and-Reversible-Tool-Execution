# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_harness

# Full connection string used by the app. Must match the POSTGRES_* values
# above when running via docker-compose (host "db" is the compose service name).
DATABASE_URL=postgresql://postgres:postgres@db:5432/agent_harness

# --- Harness behavior --------------------------------------------------------
# Number of consecutive, human-approved, clean executions of a given
# action_type required before that action_type is allowed to run
# autonomously (without HITL approval). See README "Trust threshold
# justification" for why 3 is the default.
TRUST_THRESHOLD=3

# When true, app/services/llm_mock.py is used to turn prompts into tool
# intents instead of calling a real hosted model. Kept true for automated
# evaluation, since grading cannot depend on a live model/API key.
MOCK_LLM_ENABLED=true

# --- API ---------------------------------------------------------------------
# Port the FastAPI app is exposed on, both inside the container and on the
# host via docker-compose. Must match submission.json's testData.apiPort.
API_PORT=8000
